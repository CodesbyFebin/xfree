      "item": {
        "@type": "DefinedTerm",
        "@id": "https://www.xfree.in/capabilities/robots-txt-generator",
        "name": "Robots.txt Generation & Rule Testing",
        "description": "Compose RFC 9309 robots.txt rule groups by user-agent and test whether a given path would be allowed or disallowed.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "userAgent": {
                    "type": "string"
                  },
                  "allow": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "disallow": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "sitemapUrls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "testPath": {
              "type": "string"
