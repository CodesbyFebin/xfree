            "testResult": {
              "type": "string",
              "enum": [
                "allowed",
                "disallowed"
              ],
              "nullable": true
            }
          }
        },
        "hasDefinedTerm": {
          "@type": "Tool",
          "toolCount": 1,
          "tools": [
            {
              "toolId": "robots-txt-generator",
              "toolTitle": "Robots.txt Generator & User-Agent Rule Tester",
              "toolUrl": "https://www.xfree.in/tools/robots-txt-generator",
              "requiredAuth": false,
              "supportsBatch": false,
              "estimatedLatencyMs": 15
            }
          ]
        }
