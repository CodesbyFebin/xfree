{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "XFree Capabilities",
  "description": "Structured capability definitions for all tools in the XFree registry",
  "url": "https://www.xfree.in",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "url": "https://www.xfree.in/capabilities/xml-sitemap-generator",
      "item": {
        "@type": "DefinedTerm",
        "@id": "https://www.xfree.in/capabilities/xml-sitemap-generator",
        "name": "XML Sitemap Generation & Validation",
        "description": "Convert a line-separated list of URLs into a schema-compliant XML sitemap, splitting into a sitemap index above the 50,000-URL / 50 MB limit.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "urls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            },
            "priority": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "changefreq": {
              "type": "string",
              "enum": [
                "always",
                "hourly",
                "daily",
                "weekly",
                "monthly",
                "yearly",
                "never"
              ]
            }
          },
          "required": [
            "urls"
          ]
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "sitemapXml": {
              "type": "string"
            },
            "sitemapIndexXml": {
              "type": "string",
              "nullable": true
            }
          }
        },
        "hasDefinedTerm": {
          "@type": "Tool",
          "toolCount": 1,
          "tools": [
            {
              "toolId": "xml-sitemap-generator",
              "toolTitle": "XML Sitemap Generator & Validator",
              "toolUrl": "https://www.xfree.in/tools/xml-sitemap-generator",
              "requiredAuth": false,
              "supportsBatch": true,
              "estimatedLatencyMs": 50
            }
          ]
        }
      }
    },
    {
