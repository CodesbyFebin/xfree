# --- Runtime ---
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=https://www.xfree.in
TRUST_PROXY=1

# --- Google Gemini ---
# Required in production. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model IDs — set to models available on your Google AI key.
# See https://ai.google.dev/gemini-api/docs/models for the current list.
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_THINKING_MODEL=gemini-2.5-pro
GEMINI_BATCH_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_REQUEST_TIMEOUT_MS=30000

# --- AI abuse controls ---
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=100
AI_THINKING_LIMIT_PER_DAY=15
AI_BATCH_MAX_ITEMS=20
AI_GLOBAL_DAILY_LIMIT=5000

# --- Contact / Feedback delivery ---
# If RESEND_API_KEY is set, contact + feedback are emailed via Resend.
# Otherwise submissions are logged to stdout for you to wire to another sink.
CONTACT_TO_EMAIL=contact@xfree.in
CONTACT_FROM_EMAIL=noreply@xfree.in
RESEND_API_KEY=

# --- Optional Redis (not required; in-memory limiter is used when unset) ---
REDIS_URL=

# --- Paid API Provider Keys (Venice AI, DeepSeek) ---
# These are paid APIs requiring authentication. They are only reachable
# via explicit model requests in /api/nvidia/chat, never in the free "auto"
# cascade. Anonymous access returns 401 AUTH_REQUIRED.
VENICE_API_KEY=
DEEPSEEK_API_KEY=

# --- NVIDIA Cloud API Key ---
NVIDIA_API_KEY=

# --- OpenRouter API Key (free-tier fallback) ---
OPENROUTER_API_KEY=

# --- Fal.ai Video Generation API Key ---
FAL_API_KEY=

# --- Studio API Keys (comma-separated) ---
# API keys that allow authenticated access to paid features.
STUDIO_API_KEYS=

# --- Provider Kill Switches ---
# Set to 'true' to disable a specific provider without removing the API key.
# VENICE_DISABLED=true disables Venice AI
# DEEPSEEK_DISABLED=true disables DeepSeek
# VIDEO_DISABLED=true disables video generation
VENICE_DISABLED=
DEEPSEEK_DISABLED=
VIDEO_DISABLED=

# --- Model Allowlists (comma-separated) ---
# Restricts which models a provider can serve. Empty means all are allowed.
ALLOWED_VENICE_MODELS=
ALLOWED_DEEPSEEK_MODELS=

# --- AI Abuse Controls (used by /api/nvidia/chat) ---
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=100
AI_GLOBAL_DAILY_LIMIT=5000
