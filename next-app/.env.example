# --- Free-tier Cloud Mode providers (no spend risk if left unset) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MAX_OUTPUT_TOKENS=2048
NVIDIA_REQUEST_TIMEOUT_MS=45000
OPENROUTER_API_KEY=

# --- Distributed rate limiting (required before enabling any paid tier below) ---
# Create a free Upstash Redis database at https://console.upstash.com and
# paste its REST URL/token here. Every paid-provider endpoint fails closed
# (503 RATE_LIMITER_NOT_CONFIGURED) until both are set - see
# lib/security/rateLimiter.ts and docs/SECURITY_MODEL.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Paid Cloud Mode tier: Venice / DeepSeek (explicit-pick-only) ---
# Requires UPSTASH_REDIS_REST_URL/TOKEN above. Must be the literal string
# "true" - any other value (including unset) keeps this tier disabled.
NVIDIA_PAID_TIER_ENABLED=false
VENICE_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_PAID_GLOBAL_DAILY_LIMIT=200

# --- Paid video generation (fal.ai) ---
# Also requires UPSTASH_REDIS_REST_URL/TOKEN above.
VIDEO_GENERATION_ENABLED=false
FAL_API_KEY=
VIDEO_MAX_CONCURRENT_JOBS=3
VIDEO_GLOBAL_DAILY_LIMIT=50

# --- Contact form delivery ---
# If RESEND_API_KEY is set, contact submissions are emailed via Resend.
# Otherwise they're logged to stdout (Vercel function logs) for you to
# wire to another sink. Contact rate limiting uses Upstash when configured
# above, and an in-memory per-instance fallback otherwise.
CONTACT_TO_EMAIL=contact@xfree.in
CONTACT_FROM_EMAIL=noreply@xfree.in
RESEND_API_KEY=
