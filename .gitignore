# api/index.js is checked in — it's the Vercel function bundle produced by
# `npm run build:function` from api/_handler.ts. Vercel's build pipeline
# proved too opinionated to reliably regenerate it during deploy, so we
# commit the artifact and regenerate before every push that touches src/.
